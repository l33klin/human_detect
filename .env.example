# Paths are relative to the working directory.
HD_MODELS_DIR=models
HD_DATABASE=data/identities.sqlite3
HD_DEVICE=pci:0
# Compose only: set to `stat -c '%g' /dev/apex_0` (pn41: 1004).
# HD_APEX_GID=1004
# HD_BIND_ADDRESS=0.0.0.0
# Optional LAN bearer token. Leave empty for a trusted localhost-only listener.
HD_API_KEY=
HD_PERSON_THRESHOLD=0.5
HD_FACE_THRESHOLD=0.6
# Starting points only; calibrate against your own enrollment and camera footage.
HD_SIMILARITY_THRESHOLD=0.65
HD_IDENTITY_MARGIN=0.08
HD_MIN_FACE_PIXELS=32
HD_MAX_PEOPLE=20
HD_MAX_STREAMS=4
HD_STREAM_FPS=5
HD_STREAM_TIMEOUT_MS=5000
HD_INFERENCE_QUEUE_SIZE=4
HD_INFERENCE_TIMEOUT_SECONDS=15
HD_MAX_UPLOAD_BYTES=10485760
HD_MAX_IMAGE_PIXELS=20000000
# Video tracking and bounded identity reuse; static images always run full TPU inference.
HD_TEMPORAL_ENABLED=true
HD_TEMPORAL_DETECT_EVERY=5
HD_TEMPORAL_DETECTION_SECONDS=0.5
HD_TEMPORAL_IDENTITY_SECONDS=1
# Verified empty scenes always wake on motion; disabling temporal disables this gate too.
HD_EMPTY_SCENE_ENABLED=true
HD_EMPTY_SCENE_SECONDS=2
HD_MOTION_PIXEL_THRESHOLD=18
HD_MOTION_CHANGED_FRACTION=0.002
# ffmpeg: CPU decoding; vaapi: mandatory GPU decoding with the verified I420 path.
# VAAPI requires ffmpeg, an Intel VA driver and access to the render device.
HD_CAPTURE_BACKEND=ffmpeg
HD_VAAPI_DEVICE=/dev/dri/renderD128
